# URL pública del sitio (con https y sin barra final). Define el dominio que
# usan metadataBase, Open Graph, sitemap.xml y robots.txt.
# Si se omite: en Vercel se usa VERCEL_PROJECT_PRODUCTION_URL y en local
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.example

# Código de verificación de Google Search Console (opcional). Sin valor no se
# emite la etiqueta google-site-verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
